# --- Payments (Razorpay) ---
# Leave unset to run in DEMO mode: checkout simulates a successful ₹499 payment
# so the full report flow can be exercised without keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Report narration (optional) ---
# When set, the paid report opens with a Claude-written plain-language summary.
# Eligibility itself is NEVER decided by the LLM — matching is deterministic
# (lib/engine) against hand-encoded rules in data/schemes.json. The model only
# narrates results that are already computed.
ANTHROPIC_API_KEY=

# --- Accounts & OTP email (Gmail) ---
# AUTH_SECRET — long random string (min 32 chars) used for both session cookie
# signing (HMAC-SHA256) and stateless OTP derivation.  REQUIRED in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# When unset, falls back to "yojanascan-dev-secret" — fine for local dev only.
AUTH_SECRET=

# GMAIL_USER / GMAIL_APP_PASSWORD — Gmail SMTP credentials.
# Setup: Google Account → Security → 2-Step Verification → App passwords.
# Remove spaces from the 16-char app password before pasting.
# When BOTH are set, OTPs are delivered by email (mode: "gmail").
# When either is missing, the API returns the code in the JSON response
# (mode: "demo") so the full flow is testable without credentials.
GMAIL_USER=
GMAIL_APP_PASSWORD=
